#
# 重新定义一些东西的样子.
#

# 事件日志中的聊天消息

# from, text, when
set EVENT_PUBLIC {
	if (mynick() eq $1) {
		return "\cF" . dstamp($3) . " \c6<\c0 $+ $1 $+ \c6>\cF $2";
	}
	else if (mynick() isin $2) {
		return "\cF" . dstamp($3) . " \c6<\c8 $+ $1 $+ \c6>\cF $2";
	}
	else {
		return "\cF" . dstamp($3) . " \c6<\cF $+ $1 $+ \c6>\cF $2";
	}
}

# from, to, text, when
set EVENT_PRIVATE {
	if (mynick() eq $1 && mynick() eq $2) {
		return "\cF" . dstamp($4) . " \cE-> [\cB $+ $1 $+ \cE]\cF $3 $+ \n" .
		       "\cF" . dstamp($4) . " \cE<- [\c9 $+ $1 $+ \cE]\cF $3";
	}
	else if (mynick() eq $1) {
		return "\cF" . dstamp($4) . " \cE-> [\cB $+ $2 $+ \cE]\cF $3";
	}
	else if (mynick() eq $2) {
		return "\cF" . dstamp($4) . " \cE<- [\c9 $+ $1 $+ \cE]\cF $3";
	}
}

# from, text, when
set EVENT_ACTION {
	# I sent the action
	if (mynick() eq $1) {
		return "\cF" . dstamp($3) . " \c6*\c0 $1 \cF $+ $2";
	}
	# someone else sent the action
	else {
		return "\cF" . dstamp($3) . " \c6*\cF $1 $2";
	}
}

# from, when
set EVENT_JOIN {
	return "\cF" . dstamp($2) . " \c3***\c9 $1 \c3has joined.";
}

# from, when
set EVENT_QUIT {
	return "\cF" . dstamp($2) . " \cA***\cB $1 \cAhas left.";
}

# text, when
set EVENT_NOTIFY {
	return "\cF" . dstamp($2) . " \c7*** $1";
}

# from, text, when
set EVENT_NEWSITE {
	return "\cF" . dstamp($3) . " \c7*** $1 $2";
}

# to, when
set EVENT_NOUSER {
	return "\cF" . dstamp($2) . " \c5***\c4 $1 \c5is not here.";
}

set EVENT_BEACON_INITIAL {
	return "\cF" . dstamp($2) . " \c7*** initial beacon from\c8 $1";
}

set EVENT_SSH_INITIAL {
	return "\cF" . dstamp($2) . " \c7*** new ssh session\c8 $1";
}

# @users
set EVENT_USERS {
	local('$out $user');
	$out  = "\n\cF Users\n";
	$out .= "\cE -----\n";
	foreach $user ($1) {
		$out .= "\cF $user $+ \n";
	}

	return $out;
}

set EVENT_SBAR_LEFT {
	return "[" . tstamp(ticks()) . "] " . mynick(); 
}

set EVENT_SBAR_RIGHT {
	local('$privateIP $beacons');
    $beacons = size(beacons());
    $privateIP = localip();

    return "[TeamServer IP:\c6 $privateIP \o| \c4Beacons: $beacons\o | lag: $1 $+ ]";
}

# weblog

# method, uri, addr, ua, response, size, handler, when
set WEB_HIT {
	local('$out $now $method $uri $addr $ua $response $size $handler $when $params $port');
	($method, $uri, $addr, $ua, $response, $size, $handler, $params, $when, $port) = @_;

	$now  = dstamp($when);
	$out  = "$now visit (port $port $+ ) from\cE:\o $addr $+ \n";
	$out .= "\tRequest\cE:\o $method $uri $+ \n";

	if ($handler ne "") {
		$out .= "\t $+ $handler $+ \n";
	}
	else {
		$out .= "\tResponse\cE:\c4 $response $+ \n";
	}

	$out .= "\t $+ $ua $+ \n";

	if (size($params) > 0) {
		local('$key $value');

		$out .= "\t= Form Data=\n";

		foreach $key => $value ($params) {
			$out .= "\t $+ $[10]key = $value $+ \n";
		}
	}

	return "$out $+ \n";
}

set PROFILER_HIT {
	local('$out $app $ver');
	
	$out = "\c9[+]\o $1 $+ / $+ $2 [ $+ $5 $+ ] Applications";
	foreach $app => $ver ($4) {
		$out .= "\n\t $+ $[25]app $ver";
	}

	return "$out $+ \n\n";
}

set KEYLOGGER_HIT {
	local('$date $data $r $d $f');
	$date = formatDate('yyyy-MM-dd HH:mm:ss Z');
	$data = split(',', $3);

	foreach $d ($data) {
		if ($d eq '8') {
			$r .= '<DEL>';
		}
		else if ($d eq '9') {
			$r .= '<TAB>';
		}
		else if ($d eq '13' || $d eq '10') {
			$r .= '<ENTER>';
		}
		else if ($d ne "") {
			$f = chr(formatNumber($d, 16, 10));
			$r .= $f;
		}
	}

	return "\c9[+]\o $2 [ $+ $4 $+ ] Keys $1 $+ : $r $+ \n";
}

# beacon 控制台

# beaconid, %meta
set BEACON_SBAR_LEFT {
    local('$hostname $username $pid $is64 $arch $hostarch $bnote $bnote_full $parentbeaconID');
	($hostname, $username, $pid, $is64, $arch) = values($2, @('computer', 'user', 'pid', 'is64', 'arch'));

    # 主机是 64 位还是 32 位
    if ($is64)
    {
        $hostarch = "x64"
    }
    else
    {
        $hostarch = "x86"
    }

    # 信标 PID 是进程 64 位还是 32 位
    $pid = $pid . " - $arch";

    # 这个信标有父信标吗？
    $parentbeaconID = beacon_info($1,"pbid");
    if($parentbeaconID) {
        local('$pbid');
        $pbid = beacon_info($parentbeaconID,"pid");
        $pid = $pid . " | Parent $pbid";
    }

    $bnote_full = binfo($1, "note");
    if(strlen($bnote_full) == 0) {
        $bnote = "";
    }
    else  {
        if(strlen($bnote_full) > 50) {
           # Truncate long notes
            $bnote = " | Note: " . substr($bnote_full,0,49) . "...";
        } else {
            $bnote = " | Note: " . $bnote_full;
        }
    }

    return "[\c2 $+ $hostname $+ \o] - $hostarch |  $username | $pid " . $bnote;
}

# beaconid, %meta
set BEACON_SBAR_RIGHT {
	local('$last');
    $last = $2["lastf"];
    return "last: $+ $[6]last $+ ";
}

# beaconid, message
set BEACON_CHECKIN {
	return "\c9[+]\o " . strrep($2, ':', "\cE:\o");
}

# beaconid, error
set BEACON_ERROR {
	return "\c4[-]\o " . strrep($2, ':', "\cE:\o");
}

# beaconid, warning
set BEACON_WARNING {
   return "\c8[!]\o " . strrep($2, ':', "\cE:\o");
}

# beaconid, whatever: meh
set BEACON_TASKED {
	return "\cC[*]\o " . strrep($2, ':', "\cE:\o");
}

# beaconid, whatever: meh too
set BEACON_OUTPUT {
	return "\c9[+]\o " . replace($2, "([a-z]):\n", "\$1\cE:\n\o", 1);
}

# beaconid, whatever: meh too
set BEACON_OUTPUT_ALT {
	return "\cC[*]\o " . strrep($2, ":\n", "\cE:\n\o");
}

# BEACON_OUTPUT_PS
#Cobalt Strike 进程树攻击者脚本
#原作者@ars3n11 https://github.com/ars3n11/Aggressor-Scripts/blob/master/ProcessTree.cna

set BEACON_OUTPUT_PS {
	local('$bd $maxdepth');
    $bd = bdata($1);

    # @final_ps 是最终的数组。 它是在我们弄清楚所有的孩子-父母关系时建立的
    # @reverse_ps 用于附加以最低 pid 开头的子代
    # @temp_ps 是一个临时数组

    local('@ps @final_ps @reverse_ps @temp_ps');
    local('$outps $temp $name $ppid $pid $arch $user $session');
    local('$final_ps_size $temp_name');

    #$outps .= "\cC[*]\o 带有进程突出显示的进程列表\n";

    $outps .= "\cC[*]\o Process List\n\n";
    $outps .= "\cC[*]\o This Beacon PID:   \c8 YELLOW ". $bd['pid'] ." \o \n";
    $outps .= " PID   PPID  Name                                   Arch  Session     User\n";
    $outps .= "\cE ---   ----  ----                                   ----  -------     ----\n";

    foreach $temp (split("\n", ["$2" trim])) {
        ($name, $ppid, $pid, $arch, $user, $session) = split("\t", $temp);

        # 以黄色突出显示当前进程
        if ($pid == $bd['pid']) {
            push(@ps, %(pid => $pid, ppid => $ppid, pid_formatted => "$[5]pid", ppid_formatted => "$[5]ppid", color => "\c8", name => $name, arch => "$[5]arch", session => "$[11]session", user => $user));
        }

        else {
            push(@ps, %(pid => $pid, ppid => $ppid, pid_formatted => "$[5]pid", ppid_formatted => "$[5]ppid", color => "", name => $name, arch => "$[5]arch", session => "$[11]session", user => $user));
        }
    }

    # 请对流程进行排序
    sort({ return $1['pid'] <=> $2['pid']; }, @ps);

    # 以升序子排序顺序的相反顺序获取 @ps 数组
    @reverse_ps = reverse(@ps);


    # 查找所有孤立进程并将它们添加到 final_ps。 那些是进程树的根
    sub buildOrphanage{
        local('$counter4 $counter5 $orphan');
        for ($counter4 = 0; $counter4 < size($1); $counter4++){
            $orphan = true;

            for ($counter5 = 0; $counter5 < size($1); $counter5++){
                if ($1[$counter4]['ppid'] == $1[$counter5]['pid']){
                    $orphan = false;
                    break;
                }
            }

            # PID zero - it's gotta be an orphan, poor kid
            if ($1[$counter4]['pid'] == 0){
                $orphan = true;
            }


            if ($orphan == true){
                #设置缩进并推送到@final_ps
                $1[$counter4]['indent'] = "";
                push($2, $1[$counter4]);
            }
        }
    }

    # 在数组中查找给定 PID 的索引
    sub findArrayElement{
        local('$index $value');
        foreach $index => $value ($1){
            if ($1[$index]['pid'] == $2){
                return $index;
            }
        }
        return $null;
    }

    # 将父级及其所有子级添加到 temp_ps，然后将其复制到 final_ps
    sub addChildrenProcesses{
        local ('$parent $potentialChild $arrayIndex');
        # 对于当前 final_ps 中的每个父级
        foreach $parent ($2){

            # 检查那个父母是否已经在那里
            $arrayIndex = findArrayElement($1, $parent['pid']);

            # 如果父母不在那里 - 首先添加它
            if ($arrayIndex == $null){
                #add the parent first
                push($1, $parent);

                # 为孩子更新 arrayIndex 跟随
                $arrayIndex = size($1) - 1;
            }

            #现在找到该进程的所有子进程并将其插入父进程下方
            foreach $potentialChild ($3){
                if ($potentialChild['ppid'] ==  $parent['pid'] &&  $potentialChild['ppid'] != $potentialChild['pid']){
                    $potentialChild['indent'] = $parent['indent'] . "    ";
                    add($1, $potentialChild, $arrayIndex + 1);
                }
            }
        }
        # update @final_ps
        $2 = copy($1);
        # clear temp_ps
        clear($1);
    }

    buildOrphanage(@ps, @final_ps);

    # 直到@final_ps 的大小与@ps 不同，继续添加子项
    # 警告：如果某些东西不能正常工作，这将创建一个无限循环，Cobalt Strike 会自行挂起
    # A max depth of 100 has been set to stop this condition
    while (size(@final_ps) < size(@ps)){
        $maxdepth += 1;
        addChildrenProcesses(@temp_ps, @final_ps, @reverse_ps);
        $final_ps_size = size(@final_ps);
        # Prevent infinate loop
        if ($maxdepth > 100) {
            break;
        }
    }

    # 在无限循环的情况下，这可用于调试
    # for ($counter1 = 0; $counter1 < 10; $counter1++){
    # 	addChildrenProcesses(@temp_ps, @final_ps, @reverse_ps);
    # }

    # 附加到我们的外弦
    foreach $temp (@final_ps) {
        # for some reason this was the best way to format that string
        $temp_name = $temp['indent'] . $temp['name'];

        $outps .= "$temp['color'] $temp['pid_formatted'] $temp['ppid_formatted'] $[38]temp_name $temp['arch'] $temp['session'] $temp['user']\o\n";
    }

    # 清除这些数组，因为由于某种原因它们在每次攻击者脚本运行后仍然存在
    clear(@final_ps);
    clear(@ps);

    return $outps;
}

# ls 命令的输出
set BEACON_OUTPUT_LS {
	local('$out @results $cwd $entry $type $size $modified $name');
	@results = split("\n", ["$2" trim]);

	$cwd = left(shift(@results), -1);	# first entry is the current folder

	# parse/process results
	foreach $entry (@results) {
		($type, $size, $modified, $name) = split("\t", $entry);
		if ($type eq "F") {
			$entry = %(type => "fil", size => format_size($size), modified => $modified, name => $name);
		}
		else if ($type eq "D" && $name ne "." && $name ne "..") {
			$entry = %(type => "dir", size => "", modified => $modified, name => $name);
		}
		else {
			remove();
		}
	}

	# 按字母顺序排序，目录列表在顶部.
	sort({ return ($1['type'] . lc($1['name'])) cmp ($2['type'] . lc($2['name'])); }, @results);

	$out .= "\cC[*]\o Listing: $cwd $+ \n\n";
	$out .= " Size     Type    Last Modified         Name\n";   
	$out .= "\cE ----     ----    -------------         ----\n";

	foreach $entry (@results) {
		($type, $size, $modified, $name) = values($entry, @('type', 'size', 'modified', 'name'));
		$out .= " $[8]size $[7]type $[21]modified $name $+ \n";
	}

	return $out;
}

# 作业命令的输出
set BEACON_OUTPUT_JOBS {
	local('$out $temp $jid $pid $desc');
	$out .= "\cC[*]\o Jobs\n\n";
	$out .= " JID  PID   Description\n";
	$out .= "\cE ---  ---   -----------\n";

	foreach $temp (split("\n", ["$2" trim])) {
		($jid, $pid, $desc) = split("\t", $temp);
		$out .= " $[4]jid $[5]pid $desc $+ \n";
	}

	return $out;
}

set BEACON_OUTPUT_DOWNLOADS {
	local('$out $entry $name $path $size $rcvd $pct');
	$out .= "\cC[*]\o Downloads\n\n";
	$out .= " Name               Size    Received        Path\n";
	$out .= "\cE ----               ----    --------        ----\n";
	
	foreach $entry ($2) {
		($name, $path, $size, $rcvd) = values($entry, @("name", "path", "size", "rcvd"));
		$pct  = round((double($rcvd) / $size) * 100.0, 1) . '%';
		$size = format_size($size);
		$rcvd = format_size($rcvd);
		$rcvd = "$rcvd ( $+ $pct $+ )";

		$out .= " $[18]name $[7]size $[15]rcvd $path $+ \n";
	}

	return $out;
}

set BEACON_OUTPUT_EXPLOITS {
	local('$out $exp $desc');

	$out  = "\n";
	$out .= "Beacon Local Exploits\n";
	$out .= "\cE=====================\n\n";
	$out .= "    Exploit                         Description\n";
	$out .= "\cE    -------                         -----------\n";

	foreach $exp (sorta(beacon_exploits())) {
		$desc = beacon_exploit_describe($exp);
		$out .= "    $[26]exp $+ $[6]null $+ $desc $+ \n";
	}

	return $out;
}

